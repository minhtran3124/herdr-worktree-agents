# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# rustfmt owns Rust formatting (board/rustfmt.toml); this only keeps editors in step.
[*.rs]
indent_size = 4
max_line_length = 120

[*.{sh,bash}]
max_line_length = 120

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false

[Cargo.lock]
insert_final_newline = unset
trim_trailing_whitespace = unset
